{{- /* Built from .chezmoidata/apps.toml: a selected app skips its `ignore` files, any other app is skipped whole. */ -}}
{{- $selected := get . "selected" | default list -}}
{{- range $name, $app := .apps }}
{{-   if has $name $selected }}
{{-     range get $app "ignore" | default list }}
{{ . }}
{{-     end }}
{{-   else }}
{{-     range $app.paths }}
{{ . }}
{{-     end }}
{{-   end }}
{{- end }}
