{{- $features := list -}}
{{- if hasKey . "features" }}{{ $features = .features }}{{ end -}}
{{- /*
$features stays empty until `chezmoi init` has generated the config file.
hasKey is required rather than `default`: chezmoi runs templates with
missingkey=error, so a bare `.features` aborts EVERY chezmoi command on a
machine that has not been init'd yet. Empty means "core only", which is the
safe direction to fail -- ignoring a file never deletes it, it just stops
chezmoi managing it.
*/ -}}

# ---- Machine-local or generated: never tracked, on any machine -------------
# config.kdl include's these two with `optional=true`, so a fresh machine that
# has neither gets a logged warning instead of a fatal config error, and every
# host keeps its own copy to edit in place.
.config/niri/noctalia.kdl
.config/niri/cfg/outputs.kdl
.config/foot/themes/noctalia
.config/nvim/lua/palette.lua
.config/fish/fish_variables

# Generated by lazy.nvim on every :Lazy update. Tracking it across two machines
# with autoCommit+autoPush guarantees divergence: each machine rewrites it, the
# second push is rejected, and a force push destroys the other's commit (this
# cost a laptop commit on 2026-08-04). Each machine keeps its own lockfile, so
# :Lazy restore still works locally -- only the cross-machine race is gone.
.config/nvim/lazy-lock.json

# ---- Feature gates: answered once at `chezmoi init` ------------------------
{{ if not (has "gui" $features) }}
.config/niri
.config/noctalia
.config/ghostty
.config/mpv
.chezmoiscripts/install-uosc.sh
{{ end }}
{{ if not (has "claude" $features) }}
.claude
{{ end }}

