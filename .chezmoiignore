# Matugen/Noctalia-generated theme files — rewritten on every colorscheme change,
# so they're not tracked (would show as perpetually modified). Noctalia/matugen
# regenerates them on the target machine when a theme is applied.
.config/niri/noctalia.kdl
.config/foot/themes/noctalia
.config/nvim/lua/matugen.lua
.claude/themes/ansi.json

# --- Per-machine / machine-specific: deliberately NOT tracked ---
# niri display & monitor layout (outputs/scale/resolution) differs per machine
.config/niri/cfg/display.kdl
# fish-managed universal var state; PATH is set portably in conf.d/20-paths.fish (~)
.config/fish/fish_variables
# machine-specific git signing key — git includes config.local; each machine keeps its own
.config/git/config.local

# yazi plugins & flavors are full upstream repo clones, pinned in package.toml
# and reinstalled with `ya pkg install`. Track only the manifest + config.
.config/yazi/plugins
.config/yazi/flavors
