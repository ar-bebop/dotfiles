# Noctalia auto-installs enabled plugins from plugins.json on startup, so track
# only the manifest (.config/noctalia/plugins.json) — never the upstream plugin
# code. This also avoids chezmoi's additive re-add never removing plugin folders
# you've deleted: add/remove plugins by editing plugins.json instead.
.config/noctalia/plugins

# Matugen/Noctalia-generated theme files — rewritten on every colorscheme change,
# so they're not tracked (would show as perpetually modified). Noctalia/matugen
# regenerates them on the target machine when a theme is applied.
.config/niri/noctalia.kdl
.config/foot/themes/noctalia
.config/nvim/lua/matugen.lua
