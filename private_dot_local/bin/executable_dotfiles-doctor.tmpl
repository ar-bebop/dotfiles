#!/bin/sh
# dotfiles-doctor -- report tools these dotfiles expect that this machine lacks.
#
# GENERATED by chezmoi from .chezmoidata/tools.toml. Edit that file, not this
# one; `chezmoi apply` rewrites this script.
#
# Reports only. It never installs anything and always exits 0, because it also
# runs from a run_after_ script -- i.e. after chezmoi has already written every
# file. A non-zero exit there could not roll anything back; it would only make a
# perfectly good `chezmoi apply` look like it had failed.
#
# It names binaries, never packages. These configs run on CachyOS, Alpine,
# Fedora, Debian and Ubuntu, where one binary has several package names and
# sometimes none -- so the fix is left in your package manager's spelling.

set -u

features='{{ if hasKey . "features" }}{{ .features | join " " }}{{ end }}'
missing=''
count=0
total=0

want() {
    total=$((total + 1))
    if [ -n "$3" ]; then
        eval "$3" >/dev/null 2>&1 && return 0
    else
        command -v "$1" >/dev/null 2>&1 && return 0
    fi
    count=$((count + 1))
    missing="${missing}$1	$2
"
}

{{ range .tools.core }}{{ template "want" . }}{{ end }}
{{- range $feature := list "gui" "claude" }}
{{- if and (hasKey $ "features") (has $feature $.features) }}
{{- if hasKey $.tools $feature }}
{{ range (index $.tools $feature) }}{{ template "want" . }}{{ end }}
{{- end }}
{{- end }}
{{- end }}

[ "$count" -eq 0 ] && exit 0

printf '\n  dotfiles-doctor: %d of %d expected tools missing%s\n\n' \
    "$count" "$total" "${features:+ (features: $features)}"
printf '%s' "$missing" | while IFS='	' read -r name why; do
    [ -n "$name" ] || continue
    printf '    %-12s %s\n' "$name" "$why"
done
printf '\n  Nothing was installed. Re-run any time with: dotfiles-doctor\n\n'

exit 0
{{/*
Each field is escaped for a POSIX single-quoted string (' becomes '\''), so an
apostrophe in a `why`, or the quotes inside a `check` such as
python3 -c 'import libtmux', cannot break out of its argument.
*/}}
{{- define "want" -}}
want '{{ .name | replace "'" "'\\''" }}' '{{ .why | replace "'" "'\\''" }}' '{{ if hasKey . "check" }}{{ .check | replace "'" "'\\''" }}{{ end }}'
{{ end -}}
