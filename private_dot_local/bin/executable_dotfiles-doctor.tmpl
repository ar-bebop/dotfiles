#!/bin/sh
# dotfiles-doctor: report what this machine's dotfiles expect but don't have.
# Generated from .chezmoidata/apps.toml; edit that, not this. Reports only, always exits 0.
{{- $selected := get . "selected" | default list }}
{{- $offered := get . "offered" | default list }}

report=""
add() { [ -n "$2" ] && report="$report
  $1:
$2"; }

# Programs the selected apps use
missing=""
{{- range $name := $selected }}
{{-   with index $.apps $name }}
{{-     range .needs }}
command -v {{ . }} >/dev/null 2>&1 || missing="$missing    {{ $name }}: {{ . }}
"
{{-     end }}
{{-   end }}
{{- end }}
add "missing programs" "$missing"

# Tracked files must belong to an app
owned() {
    case $1 in
        .local/bin/dotfiles-doctor) ;;
{{- range $name, $app := .apps }}
        {{ range $i, $p := $app.paths }}{{ if $i }}|{{ end }}{{ $p }}|{{ $p }}/*{{ end }}) ;;
{{- end }}
        *) return 1 ;;
    esac
}
unowned=$(chezmoi managed --include files,symlinks | while read -r f; do owned "$f" || echo "    $f"; done)
add "tracked but in no app (add to apps.toml)" "$unowned"

# Files in a selected app's .config folder must be tracked or ignored
set --
{{- range $name := $selected }}
{{-   with index $.apps $name }}
{{-     range .paths }}
{{-       if hasPrefix ".config/" . }}
[ -e ~/{{ . }} ] && set -- "$@" ~/{{ . }}
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}
[ $# -gt 0 ] && add "untracked (track it, or add it to the app's ignore)" "$(chezmoi unmanaged "$@" | sed 's/^/    /')"

# apps.toml changes since the last `chezmoi init`
add "new apps, not offered here yet (run chezmoi init)" "
{{- range $name, $_ := .apps }}{{ if not (has $name $offered) }}    {{ $name }}
{{ end }}{{ end }}"
add "selected but gone from apps.toml (run chezmoi init)" "
{{- range $selected }}{{ if not (hasKey $.apps .) }}    {{ . }}
{{ end }}{{ end }}"

[ -n "$report" ] && printf '\ndotfiles-doctor%s\n' "$report"
exit 0
