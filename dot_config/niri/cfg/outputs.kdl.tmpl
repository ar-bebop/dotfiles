{{- /*
Monitor layout. This file MUST exist on every machine: config.kdl `include`s it,
and niri aborts the ENTIRE config when an include is missing -- which is exactly
what used to happen on a fresh machine while this file was in .chezmoiignore.

Monitors with no matching `output` block are auto-enabled by niri at their
preferred mode, so every host other than lain simply gets sane defaults.

TODO: niri also matches a block by "Manufacturer Model Serial" instead of by
connector name (`niri msg outputs` prints both). Switching to that would bind
these settings to the physical panels rather than to DP-1/HDMI-A-1, and this
hostname gate could then go away entirely.
*/ -}}
{{ if eq .chezmoi.hostname "lain" -}}
output "DP-1" {
    mode "2560x1440@119.998"
    scale 1
    transform "normal"
    position x=0 y=0
    focus-at-startup
}

output "HDMI-A-1" {
    mode "2560x1600@119.998"
    scale 1.6
    transform "270"
    position x=2560 y=0
}
{{- else -}}
// No output overrides for {{ .chezmoi.hostname }}; niri auto-enables every
// connected monitor at its preferred mode.
{{- end }}
