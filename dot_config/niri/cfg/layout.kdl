layout {
    gaps 10
    center-focused-column "never"
    background-color "transparent" // <- needed for noctalia-shell to set wallpaper

    default-column-width { proportion 0.98; }
    preset-column-widths {
        proportion 0.98
        proportion 0.49
        proportion 0.32
    }

    border {
        width 2
    }

    focus-ring {
        width 2
    }

    tab-indicator {
        place-within-column
    }

    struts {}
}
