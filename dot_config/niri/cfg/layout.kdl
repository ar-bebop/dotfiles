layout {
    gaps 10
    center-focused-column "never"
    background-color "transparent" // <- needed for noctalia-shell to set wallpaper

    default-column-width { proportion 0.66667; }
    preset-column-widths {
        proportion 0.3
        proportion 0.5
        proportion 0.7
    }

    border {
        width 2
    }

    focus-ring {
        width 2
    }

    tab-indicator {
        place-within-column
    }

    struts {}
}
