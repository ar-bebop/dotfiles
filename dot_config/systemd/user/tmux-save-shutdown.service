[Unit]
Description=Save tmux sessions at logout/shutdown
Documentation=man:tmux(1)

[Service]
# Does nothing on start; exists purely so its ExecStop fires when the user
# manager goes down. Unlike tmux.service this is NOT tied to
# graphical-session.target, so it also covers servers started by an ssh/mosh
# login or by hand. Save only -- deliberately no kill-server here.
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=-%h/.config/tmux/plugins/tmux-persist/scripts/save.sh quiet all

[Install]
WantedBy=default.target
