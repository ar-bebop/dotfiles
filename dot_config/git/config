[user]
    name = ar-bebop
    email = aribeir4@gmail.com
[init]
    defaultBranch = main

[color]
    ui = auto

[core]
    editor = nvim
    pager = delta
	autocrlf = input

[interactive]
    diffFilter = delta --color-only

[delta]
    syntax-theme= base16
    side-by-side = true
    line-numbers = true
    navigate = true
    hyperlinks = true
    light = false

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default
[gpg]
	format = ssh
[commit]
	gpgsign = true

# Machine-specific signing key lives in config.local (not synced; each machine keeps its own)
[include]
	path = config.local
