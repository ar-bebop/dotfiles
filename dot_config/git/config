[user]
    name = ar-bebop
    email = aribeir4@gmail.com
[init]
    defaultBranch = main

[color]
    ui = auto

[core]
    editor = nvim
    pager = delta
	autocrlf = input

[interactive]
    diffFilter = delta --color-only

[delta]
    syntax-theme= base16
    side-by-side = true
    line-numbers = true
    navigate = true
    hyperlinks = true
    light = false

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default
[gpg]
	format = ssh
[commit]
	gpgsign = true

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[user]
    signingkey = /home/bebop/.ssh/id_ed25519.pub
