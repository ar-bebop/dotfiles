{{- /*
Rendered into ~/.config/chezmoi/chezmoi.toml by `chezmoi init`, which asks which apps this machine gets.
The choices come from .chezmoidata/apps.toml; the current picks start ticked.
Unattended: chezmoi init --apply --promptMultichoice 'Apps=fish/nvim/tmux' ar-bebop/dotfiles
*/ -}}
{{- $apps := (include ".chezmoidata/apps.toml" | fromToml).apps | keys | sortAlpha -}}
{{- $selected := promptMultichoice "Apps" $apps (get . "selected" | default list) -}}
{{- $doctor := `["-c", "[ ! -x ~/.local/bin/dotfiles-doctor ] || ~/.local/bin/dotfiles-doctor"]` -}}
[git]
    autoCommit = true
    autoPush = true

# dotfiles-doctor after anything that changes files
[hooks.apply.post]
    command = "sh"
    args = {{ $doctor }}

[hooks.update.post]
    command = "sh"
    args = {{ $doctor }}

[hooks.add.post]
    command = "sh"
    args = {{ $doctor }}

[data]
    selected = {{ $selected | toToml }}
    offered = {{ $apps | toToml }}
