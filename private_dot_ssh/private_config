Host *
    AddKeysToAgent yes
    ServerAliveInterval 60
    ServerAliveCountMax 3

Host lain
    HostName 100.123.35.52
    User bebop

Host think
    HostName 100.79.55.74
    User bebop

Host devbox
    User alex
    IdentityFile ~/.ssh/google_compute_engine
    IdentitiesOnly yes
    ProxyCommand gcloud compute start-iap-tunnel devbox %p --listen-on-stdin --project=a19g-devbox --zone=us-central1-a --verbosity=warning
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m
